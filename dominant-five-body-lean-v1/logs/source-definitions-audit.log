'DominantFiveBody.satellitePairs' depends on axioms: [propext, Classical.choice, Quot.sound]
def DominantFiveBody.satellitesRelative : DominantFiveBody.Configuration → DominantFiveBody.SatelliteConfiguration :=
fun x i => DominantFiveBody.primaryRelative x (Fin.succ i)
'DominantFiveBody.satellitesRelative' depends on axioms: [propext, Classical.choice, Quot.sound]
