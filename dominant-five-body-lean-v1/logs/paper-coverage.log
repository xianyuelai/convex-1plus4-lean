def DominantFiveBody.Coorbital.h : ℝ :=
Real.pi / 3
def DominantFiveBody.Coorbital.kappa : ℝ → ℝ :=
fun t => (2 - Real.sin (t / 2) ^ 2) / (8 * Real.sin (t / 2) ^ 3) + Real.cos t
def DominantFiveBody.Coorbital.kappaPrime : ℝ → ℝ :=
fun t => -Real.cos (t / 2) / (16 * Real.sin (t / 2) ^ 4) * (6 - Real.sin (t / 2) ^ 2 + 32 * Real.sin (t / 2) ^ 5)
def DominantFiveBody.Coorbital.kernelF : ℝ → ℝ :=
fun t => Real.sin t * ((2 * Real.sin (t / 2))⁻¹ ^ 3 - 1)
def DominantFiveBody.Coorbital.pairPotential : ℝ → ℝ :=
fun t => (2 * Real.sin (t / 2))⁻¹ + 1 - Real.cos t
def DominantFiveBody.Coorbital.positiveRemainder : ℝ → ℝ :=
fun t => DominantFiveBody.Coorbital.kappa t - DominantFiveBody.Coorbital.slopeCoefficient t
def DominantFiveBody.Coorbital.slopeCoefficient : ℝ → ℝ :=
fun t =>
  if t < DominantFiveBody.Coorbital.h then DominantFiveBody.Coorbital.kernelF t / (DominantFiveBody.Coorbital.h - t)
  else if t = DominantFiveBody.Coorbital.h then 0 else DominantFiveBody.Coorbital.kernelF t / (Real.pi - t)
structure DominantFiveBody.HullOrder : Type
number of parameters: 0
fields:
  DominantFiveBody.HullOrder.labels : Equiv.Perm DominantFiveBody.Label
  DominantFiveBody.HullOrder.primary_first : self.labels 0 = 0
constructor:
  DominantFiveBody.HullOrder.mk (labels : Equiv.Perm DominantFiveBody.Label) (primary_first : labels 0 = 0) :
    DominantFiveBody.HullOrder
def DominantFiveBody.NormalizedCentralConfiguration : DominantFiveBody.MassVector →
  DominantFiveBody.Configuration → Prop :=
fun m x =>
  DominantFiveBody.CollisionFree x ∧
    DominantFiveBody.weightedPosition m x = 0 ∧
      ∀ (i : DominantFiveBody.Label), DominantFiveBody.acceleration m x i = -x i
def DominantFiveBody.OrientedSimilar : DominantFiveBody.Configuration → DominantFiveBody.Configuration → Prop :=
fun x y => ∃ b a R, 0 < a ∧ LinearMap.det ↑R.toLinearEquiv = 1 ∧ ∀ (i : DominantFiveBody.Label), y i = b + a • R (x i)
def DominantFiveBody.PositiveRatio : DominantFiveBody.MassRatio → Prop :=
fun μ => (∀ (i : DominantFiveBody.Satellite), 0 < μ i) ∧ ∑ i, μ i = 1
def DominantFiveBody.acceleration : DominantFiveBody.MassVector →
  DominantFiveBody.Configuration → DominantFiveBody.Label → DominantFiveBody.Plane :=
fun m x i => ∑ j ∈ Finset.univ.erase i, (m j / DominantFiveBody.pairDistance x i j ^ 3) • (x j - x i)
def DominantFiveBody.angularJacobian : (DominantFiveBody.Satellite → ℝ) →
  (DominantFiveBody.Satellite → ℝ) → Matrix DominantFiveBody.Satellite DominantFiveBody.Satellite ℝ :=
fun mass theta i j =>
  if i = j then ∑ k ∈ Finset.univ.erase i, mass k * DominantFiveBody.Coorbital.kappa |theta k - theta i|
  else -mass j * DominantFiveBody.Coorbital.kappa |theta j - theta i|
def DominantFiveBody.angularResidual : ℝ →
  (DominantFiveBody.Satellite → ℝ) →
    (DominantFiveBody.Satellite → ℝ) → (DominantFiveBody.Satellite → ℝ) → DominantFiveBody.Satellite → ℝ :=
fun ε μ r θ i =>
  ∑ j ∈ Finset.univ.erase i,
    μ j * r i * r j * Real.sin (θ j - θ i) *
      ((DominantFiveBody.satelliteDistance (DominantFiveBody.polarSatellites r θ) i j ^ 3)⁻¹ - (1 + ε)⁻¹)
def DominantFiveBody.augmentedPotential : DominantFiveBody.MassVector → ℝ → DominantFiveBody.Configuration → ℝ :=
fun m lam x => DominantFiveBody.potential m x + lam / 2 * DominantFiveBody.inertia m x
def DominantFiveBody.branchEqualitySet : ℝ →
  (ℝ → DominantFiveBody.SliceCoordinates) → (ℝ → DominantFiveBody.SliceCoordinates) → Set ℝ :=
fun radius first second => {s | s ∈ Set.Ico 0 radius ∧ first s = second s}
def DominantFiveBody.centeredFromRelative : ℝ →
  DominantFiveBody.MassRatio → DominantFiveBody.SatelliteConfiguration → DominantFiveBody.Configuration :=
fun ε μ q i => DominantFiveBody.liftRelative q i - (ε / (1 + ε)) • DominantFiveBody.relativeAverage μ q
def DominantFiveBody.centeredVariationSpace : DominantFiveBody.MassVector →
  Submodule ℝ DominantFiveBody.Configuration :=
fun m => (DominantFiveBody.weightedPositionLinear m).ker
def DominantFiveBody.coorbitalDistance : (DominantFiveBody.Satellite → ℝ) →
  DominantFiveBody.Satellite → DominantFiveBody.Satellite → ℝ :=
fun θ i j =>
  ‖DominantFiveBody.point (Real.cos (θ i)) (Real.sin (θ i)) - DominantFiveBody.point (Real.cos (θ j)) (Real.sin (θ j))‖
def DominantFiveBody.coorbitalFirstAngleInsertion : (Fin 3 → ℝ) →L[ℝ] DominantFiveBody.Satellite → ℝ :=
ContinuousLinearMap.pi fun i => Fin.cases 0 (fun j => ContinuousLinearMap.proj j) i
def DominantFiveBody.coorbitalHessianCoefficient : (DominantFiveBody.Satellite → ℝ) →
  (DominantFiveBody.Satellite → ℝ) → DominantFiveBody.Satellite → DominantFiveBody.Satellite → ℝ :=
fun mass theta i j =>
  if i < j then mass i * mass j * DominantFiveBody.Coorbital.kappa (theta j - theta i)
  else if j < i then mass j * mass i * DominantFiveBody.Coorbital.kappa (theta i - theta j) else 0
def DominantFiveBody.coorbitalHessianMatrix : (DominantFiveBody.Satellite → ℝ) →
  (DominantFiveBody.Satellite → ℝ) → Matrix DominantFiveBody.Satellite DominantFiveBody.Satellite ℝ :=
fun mass theta i j => DominantFiveBody.coorbitalPhysicalHessian mass theta (Pi.single i 1) (Pi.single j 1)
def DominantFiveBody.coorbitalKernel : ℝ → ℝ :=
fun t => if 0 ≤ t then DominantFiveBody.Coorbital.kernelF t else -DominantFiveBody.Coorbital.kernelF (-t)
def DominantFiveBody.coorbitalMatrix : (DominantFiveBody.Satellite → ℝ) →
  Matrix DominantFiveBody.Satellite DominantFiveBody.Satellite ℝ :=
fun θ i j => if i = j then 0 else DominantFiveBody.coorbitalKernel (θ j - θ i)
def DominantFiveBody.coorbitalPotential : (DominantFiveBody.Satellite → ℝ) → (DominantFiveBody.Satellite → ℝ) → ℝ :=
fun μ θ =>
  ∑ p ∈ DominantFiveBody.satellitePairs,
    μ p.1 * μ p.2 *
      ((DominantFiveBody.coorbitalDistance θ p.1 p.2)⁻¹ + DominantFiveBody.coorbitalDistance θ p.1 p.2 ^ 2 / 2)
def DominantFiveBody.coorbitalResidual : (DominantFiveBody.Satellite → ℝ) →
  (DominantFiveBody.Satellite → ℝ) → DominantFiveBody.Satellite → ℝ :=
fun μ θ i => ∑ j ∈ Finset.univ.erase i, μ j * DominantFiveBody.coorbitalKernel (θ j - θ i)
def DominantFiveBody.coorbitalSliceHessianMap : (DominantFiveBody.Satellite → ℝ) →
  (Fin 3 → ℝ) → (Fin 3 → ℝ) →L[ℝ] (Fin 3 → ℝ) →L[ℝ] ℝ :=
fun mass z =>
  (ContinuousLinearMap.compL ℝ (Fin 3 → ℝ) (DominantFiveBody.Satellite → ℝ) ℝ).flip
      DominantFiveBody.coorbitalFirstAngleInsertion ∘SL
    DominantFiveBody.angularHessianMap mass (DominantFiveBody.coorbitalFirstAngleInsertion z) ∘SL
      DominantFiveBody.coorbitalFirstAngleInsertion
def DominantFiveBody.coorbitalSliceHessianMatrix : (DominantFiveBody.Satellite → ℝ) →
  (Fin 3 → ℝ) → Matrix (Fin 3) (Fin 3) ℝ :=
fun mass z i j =>
  ((fderiv ℝ (fderiv ℝ (DominantFiveBody.coorbitalSlicePotential mass)) z) (Pi.single i 1)) (Pi.single j 1)
def DominantFiveBody.coorbitalSlicePotential : (DominantFiveBody.Satellite → ℝ) → (Fin 3 → ℝ) → ℝ :=
fun mass z => DominantFiveBody.coorbitalPotential mass (DominantFiveBody.coorbitalFirstAngleInsertion z)
def DominantFiveBody.coorbitalSlicePotentialDerivative : (DominantFiveBody.Satellite → ℝ) →
  (Fin 3 → ℝ) → (Fin 3 → ℝ) →L[ℝ] ℝ :=
fun mass z =>
  DominantFiveBody.angularPotentialDerivative mass (DominantFiveBody.coorbitalFirstAngleInsertion z) ∘SL
    DominantFiveBody.coorbitalFirstAngleInsertion
def DominantFiveBody.inertia : DominantFiveBody.MassVector → DominantFiveBody.Configuration → ℝ :=
fun m x => ∑ i, m i * ‖x i‖ ^ 2
def DominantFiveBody.inertiaTangentSpace : DominantFiveBody.MassVector →
  DominantFiveBody.Configuration → Submodule ℝ DominantFiveBody.Configuration :=
fun m x => DominantFiveBody.centeredVariationSpace m ⊓ (DominantFiveBody.massInnerRight m x).ker
def DominantFiveBody.liftRelative : DominantFiveBody.SatelliteConfiguration → DominantFiveBody.Configuration :=
fun q i => Fin.cases 0 q i
def DominantFiveBody.masses : ℝ → DominantFiveBody.MassRatio → DominantFiveBody.MassVector :=
fun ε μ i => Fin.cases 1 (fun i => ε * μ i) i
def DominantFiveBody.orderedPolarSlice : DominantFiveBody.HullOrder →
  (DominantFiveBody.Satellite → ℝ) → (DominantFiveBody.Satellite → ℝ) → DominantFiveBody.SliceCoordinates :=
fun sigma r theta =>
  have e := DominantFiveBody.hullSatellitePermutation sigma;
  DominantFiveBody.polarSlice (r ∘ ⇑e) fun i => theta (e i) - theta (e 0)
def DominantFiveBody.orderedSliceRoot : DominantFiveBody.PositiveMassRatio →
  ℝ → DominantFiveBody.SliceCoordinates → Prop :=
fun mu eps y =>
  DominantFiveBody.SliceRegular (eps, ↑mu) y ∧
    DominantFiveBody.OrderedSemicircle (DominantFiveBody.sliceAngles y) ∧
      DominantFiveBody.StrictConvexInOrder DominantFiveBody.standardHullOrder
          (DominantFiveBody.slicePhysicalConfiguration (eps, ↑mu) y) ∧
        DominantFiveBody.reducedResidual (eps, ↑mu) y = 0
def DominantFiveBody.pairDistance : DominantFiveBody.Configuration →
  DominantFiveBody.Label → DominantFiveBody.Label → ℝ :=
fun x i j => ‖x i - x j‖
def DominantFiveBody.pairs : Finset (DominantFiveBody.Label × DominantFiveBody.Label) :=
{p | p.1 < p.2}
def DominantFiveBody.polarPoint : ℝ → ℝ → DominantFiveBody.Plane :=
fun r θ => DominantFiveBody.point (r * Real.cos θ) (r * Real.sin θ)
def DominantFiveBody.polarSatellites : (DominantFiveBody.Satellite → ℝ) →
  (DominantFiveBody.Satellite → ℝ) → DominantFiveBody.SatelliteConfiguration :=
fun r θ i => DominantFiveBody.polarPoint (r i) (θ i)
def DominantFiveBody.potential : DominantFiveBody.MassVector → DominantFiveBody.Configuration → ℝ :=
fun m x => ∑ p ∈ DominantFiveBody.pairs, m p.1 * m p.2 / DominantFiveBody.pairDistance x p.1 p.2
def DominantFiveBody.quarterTurn : DominantFiveBody.Plane → DominantFiveBody.Plane :=
fun v => DominantFiveBody.point (-v.ofLp 1) (v.ofLp 0)
def DominantFiveBody.radialResidual : ℝ →
  (DominantFiveBody.Satellite → ℝ) →
    (DominantFiveBody.Satellite → ℝ) → (DominantFiveBody.Satellite → ℝ) → DominantFiveBody.Satellite → ℝ :=
fun ε μ r θ i =>
  r i - (r i ^ 2)⁻¹ -
      ε *
        ∑ j ∈ Finset.univ.erase i,
          μ j * (r i - r j * Real.cos (θ j - θ i)) /
            DominantFiveBody.satelliteDistance (DominantFiveBody.polarSatellites r θ) i j ^ 3 -
    ε / (1 + ε) *
      inner ℝ (DominantFiveBody.relativeAverage μ (DominantFiveBody.polarSatellites r θ))
        (DominantFiveBody.polarPoint 1 (θ i))
def DominantFiveBody.relativeAction : ℝ → DominantFiveBody.MassRatio → DominantFiveBody.SatelliteConfiguration → ℝ :=
fun eps mu q =>
  ∑ i, mu i * (‖q i‖⁻¹ + ‖q i‖ ^ 2 / 2) + eps * DominantFiveBody.relativePairPotential mu q -
    eps / (1 + eps) / 2 * ‖DominantFiveBody.relativeAverage mu q‖ ^ 2
def DominantFiveBody.relativeAverage : DominantFiveBody.MassRatio →
  DominantFiveBody.SatelliteConfiguration → DominantFiveBody.Plane :=
fun μ q => ∑ i, μ i • q i
def DominantFiveBody.relativeField : DominantFiveBody.MassRatio →
  DominantFiveBody.SatelliteConfiguration → DominantFiveBody.Plane :=
fun μ q => ∑ i, (μ i / ‖q i‖ ^ 3) • q i
def DominantFiveBody.satellitePairs : Finset (DominantFiveBody.Satellite × DominantFiveBody.Satellite) :=
{p | p.1 < p.2}
def DominantFiveBody.satellitesRelative : DominantFiveBody.Configuration → DominantFiveBody.SatelliteConfiguration :=
fun x i => DominantFiveBody.primaryRelative x (Fin.succ i)
def DominantFiveBody.shapeSpace : DominantFiveBody.MassVector →
  DominantFiveBody.Configuration → Submodule ℝ DominantFiveBody.Configuration :=
fun m x =>
  (DominantFiveBody.weightedPositionLinear m).ker ⊓
    ((DominantFiveBody.massInnerRight m (DominantFiveBody.centered m x)).ker ⊓
      (DominantFiveBody.massInnerRight m (DominantFiveBody.rotationDirection (DominantFiveBody.centered m x))).ker)
def DominantFiveBody.sliceAngles : DominantFiveBody.SliceCoordinates → DominantFiveBody.Satellite → ℝ :=
fun y i => Fin.cases 0 (fun i => y (Fin.natAdd 4 i)) i
def DominantFiveBody.slicePhysicalConfiguration : DominantFiveBody.ContinuationParameter →
  DominantFiveBody.SliceCoordinates → DominantFiveBody.Configuration :=
fun p y => (DominantFiveBody.relativeCenteredContinuous p.1 p.2) (DominantFiveBody.sliceSatellites y)
def DominantFiveBody.sliceRadii : DominantFiveBody.SliceCoordinates → DominantFiveBody.Satellite → ℝ :=
fun y i => y (Fin.castAdd 3 i)
def DominantFiveBody.tangentialResidual : (DominantFiveBody.Satellite → ℝ) →
  (DominantFiveBody.Satellite → ℝ) → (DominantFiveBody.Satellite → ℝ) → DominantFiveBody.Satellite → ℝ :=
fun μ r θ i =>
  ∑ j ∈ Finset.univ.erase i,
    μ j * r j * Real.sin (θ j - θ i) *
      ((DominantFiveBody.satelliteDistance (DominantFiveBody.polarSatellites r θ) i j ^ 3)⁻¹ - (r j ^ 3)⁻¹)
def DominantFiveBody.v1CorrectedVectorResidual : ℝ →
  DominantFiveBody.MassRatio →
    DominantFiveBody.SatelliteConfiguration → DominantFiveBody.Satellite → DominantFiveBody.Plane :=
fun eps mu q i => DominantFiveBody.vectorResidual eps mu q i + eps • DominantFiveBody.v1FieldDefect eps mu q
def DominantFiveBody.v1FieldDefect : ℝ →
  DominantFiveBody.MassRatio → DominantFiveBody.SatelliteConfiguration → DominantFiveBody.Plane :=
fun eps mu q => DominantFiveBody.relativeField mu q - (1 + eps)⁻¹ • DominantFiveBody.relativeAverage mu q
def DominantFiveBody.vectorResidual : ℝ →
  DominantFiveBody.MassRatio →
    DominantFiveBody.SatelliteConfiguration → DominantFiveBody.Satellite → DominantFiveBody.Plane :=
fun ε μ q i =>
  q i - (‖q i‖ ^ 3)⁻¹ • q i +
      ε • ∑ j ∈ Finset.univ.erase i, (μ j / DominantFiveBody.satelliteDistance q i j ^ 3) • (q j - q i) -
    ε • DominantFiveBody.relativeField μ q
def DominantFiveBody.weightedPosition : DominantFiveBody.MassVector →
  DominantFiveBody.Configuration → DominantFiveBody.Plane :=
fun m x => ∑ i, m i • x i
