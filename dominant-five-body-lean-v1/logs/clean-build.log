info: Audit/Main.lean:11:0: def DominantFiveBody.MainUniformStatement : Prop :=
∃ δ,
  0 < δ ∧
    ∀ (μ : DominantFiveBody.MassRatio),
      DominantFiveBody.PositiveRatio μ →
        ∀ (ε : ℝ),
          0 < ε →
            ε < δ →
              ∀ (σ : DominantFiveBody.HullOrder),
                ∃ x,
                  DominantFiveBody.StrictConvexCentralConfiguration (DominantFiveBody.masses ε μ) σ x ∧
                    (∀ (y : DominantFiveBody.Configuration),
                        DominantFiveBody.StrictConvexCentralConfiguration (DominantFiveBody.masses ε μ) σ y →
                          DominantFiveBody.OrientedSimilar x y) ∧
                      ∀ (y : DominantFiveBody.Configuration),
                        DominantFiveBody.StrictConvexCentralConfiguration (DominantFiveBody.masses ε μ) σ y →
                          DominantFiveBody.NondegenerateCentralConfiguration (DominantFiveBody.masses ε μ) y
info: Audit/Main.lean:12:0: def DominantFiveBody.ShapeHessianNondegenerate : DominantFiveBody.MassVector →
  ℝ → DominantFiveBody.Configuration → Prop :=
fun m lam x =>
  ∀ v ∈ DominantFiveBody.shapeSpace m x,
    (∀ w ∈ DominantFiveBody.shapeSpace m x, DominantFiveBody.physicalHessian m lam x v w = 0) → v = 0
info: Audit/Main.lean:13:0: def DominantFiveBody.physicalHessian : DominantFiveBody.MassVector →
  ℝ → DominantFiveBody.Configuration → DominantFiveBody.Configuration → DominantFiveBody.Configuration → ℝ :=
fun m lam x v w => ((fderiv ℝ (fderiv ℝ (DominantFiveBody.augmentedPotential m lam)) x) v) w
info: Audit/Main.lean:14:0: def DominantFiveBody.StrictConvexInOrder : DominantFiveBody.HullOrder → DominantFiveBody.Configuration → Prop :=
fun σ x =>
  ∀ (k j : DominantFiveBody.Label),
    j ≠ k → j ≠ k + 1 → 0 < DominantFiveBody.orientedArea x (σ.labels k) (σ.labels (k + 1)) (σ.labels j)
info: Audit/Main.lean:15:0: def DominantFiveBody.OrientedSimilar : DominantFiveBody.Configuration → DominantFiveBody.Configuration → Prop :=
fun x y => ∃ b a R, 0 < a ∧ LinearMap.det ↑R.toLinearEquiv = 1 ∧ ∀ (i : DominantFiveBody.Label), y i = b + a • R (x i)
