  (nestedFromFixedSlice t eta alpha).IsInvertible
DominantFiveBody.pairRows_recovery (t alpha : ℝ) (rows : Satellite → ℝ) (ht : t ≠ 0) :
  rows 0 = pairRowAverage alpha rows - (1 - alpha) * t * pairRowDifference t rows ∧
    rows 1 = pairRowAverage alpha rows + alpha * t * pairRowDifference t rows
DominantFiveBody.tripleRows_recovery (t : ℝ) (alpha : TripleVector) (P : Satellite → ℝ) (ht : t ≠ 0)
  (ha : ∑ i, alpha i = 1) :
  tripleClusterRows P =
    (fun x => tripleRowAverage alpha P) + t • (tripleCenteringMatrix alpha).mulVec (tripleRowDifferences t P)
DominantFiveBody.nestedRows_recovery (t eta alpha : ℝ) (rows : Satellite → ℝ) (ht : t ≠ 0) (he : eta ≠ 0) :
  nestedPairAverage alpha rows =
      nestedRowAverage eta alpha rows - (1 - eta ^ 3) * t * nestedRowOuterDifference t alpha rows ∧
    rows 2 = nestedRowAverage eta alpha rows + eta ^ 3 * t * nestedRowOuterDifference t alpha rows ∧
      rows 0 = nestedPairAverage alpha rows - (1 - alpha) * t * eta * nestedRowInnerDifference t eta rows ∧
        rows 1 = nestedPairAverage alpha rows + alpha * t * eta * nestedRowInnerDifference t eta rows
DominantFiveBody.pairChart_endpoint_gap_nonzero (t alpha : ℝ) (y : PairChartVariables)
  (hsep : SeparatedSemicircle (pairChartAngles t alpha y)) :
  pairChartAngles t alpha y 1 - pairChartAngles t alpha y 0 = t * y 6 ∧ t * y 6 ≠ 0
DominantFiveBody.tripleChart_endpoint_gaps_nonzero (t : ℝ) (alpha : TripleVector) (y : TripleChartVariables)
  (ha : ∑ i, alpha i = 1) (hsep : SeparatedSemicircle (tripleChartAngles t alpha y)) (k : Fin 2) :
  tripleChartAngles t alpha y k.succ.castSucc - tripleChartAngles t alpha y k.castSucc.castSucc =
      t * tripleChartAngularGaps y k ∧
    t * tripleChartAngularGaps y k ≠ 0
DominantFiveBody.nestedChart_endpoint_gaps_nonzero (t eta alpha : ℝ) (y : NestedChartVariables)
  (hsep : SeparatedSemicircle (nestedChartAngles t eta alpha y)) :
  nestedChartAngles t eta alpha y 1 - nestedChartAngles t eta alpha y 0 = t * eta * y 6 ∧
    t * eta * y 6 ≠ 0 ∧
      ∀ (i : Fin 2),
        nestedChartAngles t eta alpha y 2 - nestedChartAngles t eta alpha y (Fin.castAdd 2 i) =
            t * nestedOuterAngularGaps eta alpha y i ∧
          t * nestedOuterAngularGaps eta alpha y i ≠ 0
DominantFiveBody.orderedPolarSlice_angles (sigma : HullOrder) (r theta : Satellite → ℝ) :
  sliceAngles (orderedPolarSlice sigma r theta) = fun i =>
    theta ((hullSatellitePermutation sigma) i) - theta ((hullSatellitePermutation sigma) 0)
DominantFiveBody.orderedPolarSlice_radii (sigma : HullOrder) (r theta : Satellite → ℝ) :
  sliceRadii (orderedPolarSlice sigma r theta) = r ∘ ⇑(hullSatellitePermutation sigma)
DominantFiveBody.orderedPolarSlice_reindex_undo (sigma : HullOrder) (e : Equiv.Perm Satellite) (r theta : Satellite → ℝ)
  (a : ℝ) (he : hullSatellitePermutation sigma = Equiv.symm e) (hzero : theta 0 = 0) :
  (orderedPolarSlice sigma (r ∘ ⇑e) fun i => theta (e i) - a) = polarSlice r theta
DominantFiveBody.isOpen_branch_eq_of_localUniqueness.{u, v} {T : Type u} {Y : Type v} [TopologicalSpace T]
  [TopologicalSpace Y] {root : T → Y → Prop} (hlocal : LocalRootUniqueness root) {f g : T → Y} (hf : Continuous f)
  (hg : Continuous g) (hfr : ∀ (t : T), root t (f t)) (hgr : ∀ (t : T), root t (g t)) : IsOpen {t | f t = g t}
DominantFiveBody.branchEqualitySet (radius : ℝ) (first second : ℝ → SliceCoordinates) : Set ℝ
DominantFiveBody.mem_branchEqualitySet (radius s : ℝ) (first second : ℝ → SliceCoordinates) :
  s ∈ branchEqualitySet radius first second ↔ 0 ≤ s ∧ s < radius ∧ first s = second s
