  (∀ v ∈ ℝ ∙ x, ∀ w ∈ inertiaTangentSpace m x, physicalHessian m 1 x v w = 0) ∧
    physicalHessian m 1 x x x = 3 * inertia m x ∧ 0 < 3 * inertia m x
DominantFiveBody.reducedAngularJacobian_zero_eq (μ : MassRatio) (y : SliceCoordinates) (hreg : SliceRegular (0, μ) y)
