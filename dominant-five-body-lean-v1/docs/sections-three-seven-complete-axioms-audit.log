DominantFiveBody.nestedChart_compact_boundary_continuation (psi omega : ℝ) (hangle : |psi| = Coorbital.h)
  (hw : |omega| = 1) (tolerance : ℝ) (htol : 0 < tolerance) :
  ∃ delta r C,
    0 < delta ∧
      0 < r ∧
        0 < C ∧
          r ≤ tolerance ∧
            delta ≤ r ∧
              ∀ alpha ∈ Set.Icc 0 1,
                ∃ branch,
                  branch ![0, 0, 0, alpha] = nestedBasePoint psi omega ∧
                    ContDiffOn ℝ (↑⊤) branch (Metric.ball ![0, 0, 0, alpha] delta) ∧
                      ∀ (q : Fin (Nat.succ 0).succ.succ.succ → ℝ),
                        dist q ![0, 0, 0, alpha] < delta →
                          dist (branch q) (nestedBasePoint psi omega) < r / 2 ∧
                            NestedContinuationDomain (q, branch q) ∧
                              (nestedChartJacobian (q 0) (q 1) (q 2) (q 3) (branch q)).IsInvertible ∧
                                ‖(nestedChartJacobian (q 0) (q 1) (q 2) (q 3) (branch q)).inverse‖ ≤ C ∧
                                  nestedChartParameterRows q (branch q) = 0 ∧
                                    ∀ (y : NestedChartVariables),
                                      dist y (nestedBasePoint psi omega) < r →
                                        (nestedChartParameterRows q y = 0 ↔ branch q = y)
