DominantFiveBody.pairChart_compact_physical_continuation (p psi : ℝ) (keepD : Bool) (hp : 0 ≤ p) (hp1 : p ≤ 1)
  (hkeep : if keepD = true then 0 < p else p < 1) (hpsi0 : psi ≠ 0) (hpsih : psi ≠ Coorbital.h)
  (hspan : twoSourceSpan psi < Real.pi)
  (hroot : p * coorbitalKernel psi + (1 - p) * coorbitalKernel (psi - Coorbital.h) = 0) (tau : ℝ) (htau : 0 < tau) :
  have y0 := pairUnitPoint Coorbital.h psi (pairBoundaryScale (pairProbeDerivative p Coorbital.h psi));
  ∃ eta r C,
    0 < eta ∧
      0 < r ∧
        0 < C ∧
          r ≤ tau ∧
            eta ≤ r ∧
              ∀ alpha ∈ Set.Icc 0 1,
                ∃ branch,
                  branch ![0, 0, p, alpha] = y0 ∧
                    ContDiffOn ℝ (↑⊤) branch (Metric.ball ![0, 0, p, alpha] eta) ∧
                      ∀ (q : Fin (Nat.succ 0).succ.succ.succ → ℝ),
                        dist q ![0, 0, p, alpha] < eta →
                          dist (branch q) y0 < r / 2 ∧
                            PairChartRegular (q 0) (q 1) (q 3) (branch q) ∧
                              (q, branch q) ∈ pairPhysicalSafeSet (pairBoundaryHullOrder psi) ∧
                                (pairChartJacobian (q 0) (q 1) (q 2) (q 3) keepD (branch q)).IsInvertible ∧
                                  ‖(pairChartJacobian (q 0) (q 1) (q 2) (q 3) keepD (branch q)).inverse‖ ≤ C ∧
                                    pairChartParameterRows keepD q (branch q) = 0 ∧
                                      (∀ (y : PairChartVariables),
                                          dist y y0 < r → (pairChartParameterRows keepD q y = 0 ↔ branch q = y)) ∧
                                        (0 < q 0 →
                                          0 < q 1 →
                                            PositiveRatio (pairChartMass (q 1) (q 2) (q 3)) →
                                              StrictConvexCentralConfiguration
                                                  (masses (q 0) (pairChartMass (q 1) (q 2) (q 3)))
                                                  (pairBoundaryHullOrder psi) (pairChartConfiguration q (branch q)) ∧
                                                NondegenerateCentralConfiguration
                                                  (masses (q 0) (pairChartMass (q 1) (q 2) (q 3)))
                                                  (pairChartConfiguration q (branch q)))
DominantFiveBody.pairChart_compact_boundary_continuation (p psi : ℝ) (keepD : Bool) (hp : 0 ≤ p) (hp1 : p ≤ 1)
  (hkeep : if keepD = true then 0 < p else p < 1) (hpsi0 : psi ≠ 0) (hpsih : psi ≠ Coorbital.h)
  (hspan : twoSourceSpan psi < Real.pi)
  (hroot : p * coorbitalKernel psi + (1 - p) * coorbitalKernel (psi - Coorbital.h) = 0) (tau : ℝ) (htau : 0 < tau) :
  have y0 := pairUnitPoint Coorbital.h psi (pairBoundaryScale (pairProbeDerivative p Coorbital.h psi));
  ∃ eta r C,
    0 < eta ∧
      0 < r ∧
        0 < C ∧
          r ≤ tau ∧
            eta ≤ r ∧
              ∀ alpha ∈ Set.Icc 0 1,
                ∃ branch,
                  branch ![0, 0, p, alpha] = y0 ∧
                    ContDiffOn ℝ (↑⊤) branch (Metric.ball ![0, 0, p, alpha] eta) ∧
                      ∀ (q : Fin (Nat.succ 0).succ.succ.succ → ℝ),
                        dist q ![0, 0, p, alpha] < eta →
                          dist (branch q) y0 < r / 2 ∧
                            PairChartRegular (q 0) (q 1) (q 3) (branch q) ∧
                              (pairChartJacobian (q 0) (q 1) (q 2) (q 3) keepD (branch q)).IsInvertible ∧
                                ‖(pairChartJacobian (q 0) (q 1) (q 2) (q 3) keepD (branch q)).inverse‖ ≤ C ∧
                                  pairChartParameterRows keepD q (branch q) = 0 ∧
                                    ∀ (y : PairChartVariables),
                                      dist y y0 < r → (pairChartParameterRows keepD q y = 0 ↔ branch q = y)
DominantFiveBody.noCollision_physical_local_continuation (μ : MassRatio) (y : SliceCoordinates)
  (hunit : ∀ (i : Satellite), sliceRadii y i = 1) (hμ : ∀ (i : Satellite), 0 ≤ μ i) (hsum : ∑ i, μ i = 1)
  (hμ₀ : 0 < μ 0) (hsep : SeparatedSemicircle (sliceAngles y))
  (hroot : ∀ (i : Satellite), coorbitalResidual μ (sliceAngles y) i = 0) :
  ∃ e η r C,
    0 < η ∧
      0 < r ∧
        0 < C ∧
          ∃ ψ,
            OrderedSemicircle (sliceAngles y ∘ ⇑e) ∧
              ψ (0, μ) = y ∧
                ContDiffOn ℝ (↑⊤) ψ (Metric.ball (0, μ) η) ∧
                  ∀ (ε : ℝ) (ν : MassRatio),
                    |ε| < η →
                      dist ν μ < η →
                        StrictConvexInOrder (satelliteHullOrder e) (slicePhysicalConfiguration (ε, ν) (ψ (ε, ν))) ∧
                          OrderedSemicircle (sliceAngles (ψ (ε, ν)) ∘ ⇑e) ∧
                            dist (ψ (ε, ν)) y < r / 2 ∧
                              SliceRegular (ε, ν) (ψ (ε, ν)) ∧
                                (reducedJacobian (ε, ν) (ψ (ε, ν))).IsInvertible ∧
                                  ‖(reducedJacobian (ε, ν) (ψ (ε, ν))).inverse‖ ≤ C ∧
                                    reducedResidual (ε, ν) (ψ (ε, ν)) = 0 ∧
                                      (∀ (z : SliceCoordinates),
                                          dist z y < r → (reducedResidual (ε, ν) z = 0 ↔ ψ (ε, ν) = z)) ∧
                                        (0 < ε →
                                            PositiveRatio ν →
                                              NormalizedCentralConfiguration (masses ε ν)
                                                  (slicePhysicalConfiguration (ε, ν) (ψ (ε, ν))) ∧
                                                StrictConvexCentralConfiguration (masses ε ν) (satelliteHullOrder e)
                                                    (slicePhysicalConfiguration (ε, ν) (ψ (ε, ν))) ∧
                                                  ShapeHessianNondegenerate (masses ε ν) 1
                                                    (slicePhysicalConfiguration (ε, ν) (ψ (ε, ν)))) ∧
                                          (ε = 0 →
                                            PositiveRatio ν →
                                              (∀ (i : Satellite), sliceRadii (ψ (ε, ν)) i = 1) ∧
                                                RelativeCollisionFree (sliceSatellites (ψ (ε, ν))) ∧
                                                  (∀ (i : Satellite),
                                                      coorbitalResidual ν (sliceAngles (ψ (ε, ν))) i = 0) ∧
                                                    coorbitalRootAngles (ν ∘ ⇑e) = fun i =>
                                                      sliceAngles (ψ (ε, ν)) (e i) - sliceAngles (ψ (ε, ν)) (e 0))
DominantFiveBody.pairChart_fixed_mass_zero_endpoint (t p alpha : ℝ) (keepD : Bool) (y : PairChartVariables) (ht : 0 < t)
  (hm : PositiveRatio (pairChartMass t p alpha)) (hreg : PairChartRegular 0 t alpha y)
