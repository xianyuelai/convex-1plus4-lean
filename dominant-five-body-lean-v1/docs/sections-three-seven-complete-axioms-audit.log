DominantFiveBody.mem_inertiaTangentSpace (m : MassVector) (x w : Configuration) :
  w ∈ inertiaTangentSpace m x ↔ weightedPosition m w = 0 ∧ massInner m x w = 0
DominantFiveBody.centered_radial_tangent_direct_sum (m : MassVector) (hm : PositiveMasses m) (x : Configuration)
  (hx : NormalizedCentralConfiguration m x) :
