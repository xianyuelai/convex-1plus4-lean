  ((∀ (i : Satellite), radialResidual eps mu p.1 p.2 i = 0) ∧
      ∀ (i : Satellite), i ≠ omitted → angularResidual eps mu p.1 p.2 i = 0) ↔
    ∀ (i : Satellite), vectorResidual eps mu (polarCoordinateMap p) i = 0
DominantFiveBody.normalizedCC_of_reducedResidual_zero (p : ContinuationParameter) (y : SliceCoordinates)
