DominantFiveBody.sliceAction_second_fderiv_isInvertible_iff_reducedJacobian (p : ContinuationParameter)
  (y : SliceCoordinates) (hreg : SliceRegular p y) (hε : 0 < p.1) (hμ : ∀ (i : Satellite), 0 < p.2 i) :
