DominantFiveBody.centeredFromRelative_source_formulas (ε : ℝ) (μ : MassRatio) (q : SatelliteConfiguration) :
  liftRelative q 0 = 0 ∧
    centeredFromRelative ε μ q 0 = -(ε / (1 + ε)) • relativeAverage μ q ∧
      (∀ (i : Satellite), centeredFromRelative ε μ q (Fin.succ i) = q i - (ε / (1 + ε)) • relativeAverage μ q) ∧
        centeredFromRelative 0 μ q = liftRelative q ∧
          ∀ (i j : Label), pairDistance (centeredFromRelative ε μ q) i j = pairDistance (liftRelative q) i j
DominantFiveBody.reducedPolarResiduals_zero_iff_vectorRoot (eps : ℝ) (mu : MassRatio) (p : PolarCoordinates)
