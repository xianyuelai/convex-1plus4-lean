  (muLimit : MassRatio) (hmt : Filter.Tendsto mu Filter.atTop (nhds muLimit)) (qLimit : SatelliteConfiguration)
  (hqt : Filter.Tendsto (fun n => satellitesRelative (x n)) Filter.atTop (nhds qLimit)) (a b : Satellite) (hab : a < b)
  (c : Plane) (hpair : CompleteLimitingSatellitePair qLimit a b c) (theta0 : Satellite → ℝ)
  (hthetat : Filter.Tendsto theta Filter.atTop (nhds theta0)) (u w : Satellite) (huw : u < w)
  (hu : u ∈ pairExteriorLabels a b) (hw : w ∈ pairExteriorLabels a b) (e : Equiv.Perm Satellite) (he0 : e 0 = a)
  (he1 : e 1 = b) (he2 : e 2 = u) (he3 : e 3 = w) :
  ∃ keepD,
    Nonempty
      (PairCapturedBranches eps (fun n => pairPhysicalScale (mu n ∘ ⇑e)) (fun n => pairExteriorFraction (mu n ∘ ⇑e))
        (fun n => pairPhysicalFraction (mu n ∘ ⇑e))
        (fun n =>
          pairVariablesFromPolar (pairPhysicalScale (mu n ∘ ⇑e)) (pairPhysicalFraction (mu n ∘ ⇑e)) (r n ∘ ⇑e) fun i =>
            theta n (e i) - theta n u)
        (theta0 a - theta0 u) keepD)
DominantFiveBody.normalized_complete_lower_triple_regular_actual_capture (eps : ℕ → ℝ) (mu : ℕ → MassRatio)
  (x : ℕ → Configuration) (heps : ∀ (n : ℕ), 0 < eps n) (hepst : Filter.Tendsto eps Filter.atTop (nhds 0))
  (hm : ∀ (n : ℕ), PositiveRatio (mu n)) (hx : ∀ (n : ℕ), NormalizedCentralConfiguration (masses (eps n) (mu n)) (x n))
  (hconv : ∀ (n : ℕ), StrictConvexInOrder { labels := Equiv.refl Label, primary_first := ⋯ } (x n))
  (r theta : ℕ → Satellite → ℝ) (hr : ∀ (n : ℕ) (i : Satellite), 0 < r n i)
  (hpolar : ∀ (n : ℕ), satellitesRelative (x n) = polarSatellites (r n) (theta n))
  (horder : ∀ (n : ℕ) (i j : Satellite), i < j → 0 < theta n j - theta n i ∧ theta n j - theta n i < Real.pi)
  (muLimit : MassRatio) (hmt : Filter.Tendsto mu Filter.atTop (nhds muLimit)) (qLimit : SatelliteConfiguration)
  (hqt : Filter.Tendsto (fun n => satellitesRelative (x n)) Filter.atTop (nhds qLimit)) (theta0 : Satellite → ℝ)
  (htheta : Filter.Tendsto theta Filter.atTop (nhds theta0)) (center : Plane)
  (htriple : CompleteLimitingSatelliteTriple qLimit 3 center) (eta : ℝ) (heta : 0 < eta)
  (hcomparable :
    ∀ᶠ (n : ℕ) in Filter.atTop,
      ∀ (i j : TripleLabel),
        i ≠ j →
          eta * tripleLowDiameter (satellitesRelative (x n)) ≤
            satelliteDistance (satellitesRelative (x n)) (Fin.castSucc i) (Fin.castSucc j)) :
  ∃ phi,
    StrictMono phi ∧
      Nonempty
        (TripleCapturedBranches (eps ∘ phi) (fun n => triplePhysicalScale (mu (phi n)))
          (fun n => triplePhysicalWeights (mu (phi n)))
          (fun n =>
            tripleVariablesFromPolar (triplePhysicalScale (mu (phi n))) (triplePhysicalWeights (mu (phi n))) (r (phi n))
              fun i => theta (phi n) i - theta (phi n) 3)
          (-1))
DominantFiveBody.normalized_complete_lower_triple_nested_original_capture (eps : ℕ → ℝ) (mu : ℕ → MassRatio)
  (x : ℕ → Configuration) (heps : ∀ (n : ℕ), 0 < eps n) (hepst : Filter.Tendsto eps Filter.atTop (nhds 0))
  (hm : ∀ (n : ℕ), PositiveRatio (mu n)) (hx : ∀ (n : ℕ), NormalizedCentralConfiguration (masses (eps n) (mu n)) (x n))
  (hconv : ∀ (n : ℕ), StrictConvexInOrder standardHullOrder (x n)) (r theta : ℕ → Satellite → ℝ)
  (hr : ∀ (n : ℕ) (i : Satellite), 0 < r n i)
  (hpolar : ∀ (n : ℕ), satellitesRelative (x n) = polarSatellites (r n) (theta n)) (hzero : ∀ (n : ℕ), theta n 0 = 0)
  (horder : ∀ (n : ℕ), OrderedSemicircle (theta n)) (muLimit : MassRatio)
  (hmt : Filter.Tendsto mu Filter.atTop (nhds muLimit)) (qLimit : SatelliteConfiguration)
  (hqt : Filter.Tendsto (fun n => satellitesRelative (x n)) Filter.atTop (nhds qLimit)) (theta0 : Satellite → ℝ)
  (htheta : Filter.Tendsto theta Filter.atTop (nhds theta0)) (center : Plane)
  (htriple : CompleteLimitingSatelliteTriple qLimit 3 center) (a b c : TripleLabel) (hab : a < b) (hca : c ≠ a)
  (hcb : c ≠ b)
  (hpair :
    Filter.Tendsto
      (fun n =>
        satelliteDistance (satellitesRelative (x n)) (Fin.castSucc a) (Fin.castSucc b) /
          tripleLowDiameter (satellitesRelative (x n)))
      Filter.atTop (nhds 0)) :
  Nonempty
    (CapturedBranches orderedSliceRoot orderedSliceNondegenerate orderedSliceEndpoint (fun n => ⟨mu n, ⋯⟩) eps fun n =>
      polarSlice (r n) (theta n))
DominantFiveBody.nestedChart_convex_physical_continuation (alpha0 tau omega : ℝ) (halpha0 : alpha0 ∈ Set.Icc 0 1)
  (htau : tau = 1 ∨ tau = -1) (hw : omega = 1 ∨ omega = -1) (bound : ℝ) (hbound : 0 < bound) :
  ∃ delta r C,
    0 < delta ∧
      0 < r ∧
        0 < C ∧
          r ≤ bound ∧
            delta ≤ r ∧
              ∃ branch,
                branch (nestedParameter 0 0 0 alpha0) = nestedBasePoint (tau * Coorbital.h) omega ∧
                  ContDiffOn ℝ (↑⊤) branch (Metric.ball (nestedParameter 0 0 0 alpha0) delta) ∧
                    ∀ (q : NestedChartParameters),
                      dist q (nestedParameter 0 0 0 alpha0) < delta →
                        dist (branch q) (nestedBasePoint (tau * Coorbital.h) omega) < r / 2 ∧
                          NestedContinuationDomain (q, branch q) ∧
                            (nestedChartJacobian (q 0) (q 1) (q 2) (q 3) (branch q)).IsInvertible ∧
                              ‖(nestedChartJacobian (q 0) (q 1) (q 2) (q 3) (branch q)).inverse‖ ≤ C ∧
                                nestedChartParameterRows q (branch q) = 0 ∧
                                  (∀ (y : NestedChartVariables),
                                      dist y (nestedBasePoint (tau * Coorbital.h) omega) < r →
                                        (nestedChartParameterRows q y = 0 ↔ branch q = y)) ∧
                                    (0 < q 1 →
                                        0 < q 2 →
                                          q 3 ∈ Set.Icc 0 1 →
                                            StrictConvexInOrder (nestedBoundaryHullOrder tau omega)
                                              (liftRelative (nestedChartPoints (q 1) (q 2) (q 3) (branch q)))) ∧
                                      (0 < q 0 →
                                          0 < q 1 →
                                            0 < q 2 →
                                              q 3 ∈ Set.Icc 0 1 →
                                                PositiveRatio (nestedChartMass (q 1) (q 2) (q 3)) →
                                                  StrictConvexCentralConfiguration
                                                      (masses (q 0) (nestedChartMass (q 1) (q 2) (q 3)))
                                                      (nestedBoundaryHullOrder tau omega)
                                                      (nestedChartConfiguration q (branch q)) ∧
                                                    NondegenerateCentralConfiguration
                                                      (masses (q 0) (nestedChartMass (q 1) (q 2) (q 3)))
                                                      (nestedChartConfiguration q (branch q))) ∧
                                        (q 0 = 0 →
                                          0 < q 1 →
                                            0 < q 2 →
                                              PositiveRatio (nestedChartMass (q 1) (q 2) (q 3)) →
                                                (∀ (i : Satellite),
                                                    nestedChartRadii (q 1) (q 2) (q 3) (branch q) i = 1) ∧
                                                  branch q 2 = 0 ∧
                                                    branch q 3 = 0 ∧
                                                      RelativeCollisionFree
                                                          (nestedChartPoints (q 1) (q 2) (q 3) (branch q)) ∧
                                                        SeparatedSemicircle
                                                            (nestedChartAngles (q 1) (q 2) (q 3) (branch q)) ∧
                                                          ∀ (i : Satellite),
                                                            coorbitalResidual (nestedChartMass (q 1) (q 2) (q 3))
                                                                (nestedChartAngles (q 1) (q 2) (q 3) (branch q)) i =
                                                              0)
DominantFiveBody.tripleChart_convex_physical_continuation (alpha z : TripleVector) (ha : TripleWeights alpha)
  (hz : TripleOrdered z) (hscalar : ∀ (i : TripleLabel), tripleScalarResidual alpha z i = 0) (tau : ℝ)
  (htau : tau = 1 ∨ tau = -1) (bound : ℝ) (hbound : 0 < bound) :
  ∃ eta r C,
    0 < eta ∧
      0 < r ∧
        0 < C ∧
          r ≤ bound ∧
            eta ≤ r ∧
              ∃ branch,
                branch (tripleBoundaryParameter alpha) =
                    tripleUnitPoint (tau * Coorbital.h) (tripleGapMatrix.mulVec z) ∧
                  ContDiffOn ℝ (↑⊤) branch (Metric.ball (tripleBoundaryParameter alpha) eta) ∧
                    ∀ (q : TripleChartParameters),
                      dist q (tripleBoundaryParameter alpha) < eta →
                        dist (branch q) (tripleUnitPoint (tau * Coorbital.h) (tripleGapMatrix.mulVec z)) < r / 2 ∧
                          TripleChartRegular (q 0) (q 1) (tripleJointAlpha q) (branch q) ∧
                            (q, branch q) ∈ triplePhysicalRegularSet ∧
                              (tripleChartJacobian (q 0) (q 1) (tripleJointAlpha q) (branch q)).IsInvertible ∧
                                ‖(tripleChartJacobian (q 0) (q 1) (tripleJointAlpha q) (branch q)).inverse‖ ≤ C ∧
                                  tripleChartParameterRows q (branch q) = 0 ∧
                                    (∀ (y : TripleChartVariables),
                                        dist y (tripleUnitPoint (tau * Coorbital.h) (tripleGapMatrix.mulVec z)) < r →
                                          (tripleChartParameterRows q y = 0 ↔ branch q = y)) ∧
                                      (0 < q 1 →
                                          ∑ i, tripleJointAlpha q i = 1 →
                                            StrictConvexInOrder (tripleBoundaryHullOrder tau)
                                              (liftRelative
                                                (tripleChartPoints (q 1) (tripleJointAlpha q) (branch q)))) ∧
                                        (0 < q 0 →
                                            0 < q 1 →
                                              ∑ i, tripleJointAlpha q i = 1 →
                                                PositiveRatio (tripleChartMass (q 1) (tripleJointAlpha q)) →
                                                  StrictConvexCentralConfiguration
                                                      (masses (q 0) (tripleChartMass (q 1) (tripleJointAlpha q)))
                                                      (tripleBoundaryHullOrder tau)
                                                      (tripleChartConfiguration q (branch q)) ∧
                                                    NondegenerateCentralConfiguration
                                                      (masses (q 0) (tripleChartMass (q 1) (tripleJointAlpha q)))
                                                      (tripleChartConfiguration q (branch q))) ∧
                                          (q 0 = 0 →
                                            0 < q 1 →
                                              ∑ i, tripleJointAlpha q i = 1 →
                                                PositiveRatio (tripleChartMass (q 1) (tripleJointAlpha q)) →
                                                  (∀ (i : Satellite),
                                                      tripleChartRadii (q 1) (tripleJointAlpha q) (branch q) i = 1) ∧
                                                    RelativeCollisionFree
                                                        (tripleChartPoints (q 1) (tripleJointAlpha q) (branch q)) ∧
                                                      SeparatedSemicircle
                                                          (tripleChartAngles (q 1) (tripleJointAlpha q) (branch q)) ∧
                                                        ∀ (i : Satellite),
                                                          coorbitalResidual (tripleChartMass (q 1) (tripleJointAlpha q))
                                                              (tripleChartAngles (q 1) (tripleJointAlpha q) (branch q))
                                                              i =
                                                            0)
DominantFiveBody.pairChart_regular_root_physical (q : PairChartParameters) (keepD : Bool) (y : PairChartVariables)
  (sigma : HullOrder) (heps : 0 < q 0) (ht : 0 < q 1) (hm : PositiveRatio (pairChartMass (q 1) (q 2) (q 3)))
  (hreg : PairChartRegular (q 0) (q 1) (q 3) y) (hsafe : (q, y) ∈ pairPhysicalSafeSet sigma)
  (hroot : pairChartParameterRows keepD q y = 0)
  (hJ : (pairChartJacobian (q 0) (q 1) (q 2) (q 3) keepD y).IsInvertible) :
  StrictConvexCentralConfiguration (masses (q 0) (pairChartMass (q 1) (q 2) (q 3))) sigma (pairChartConfiguration q y) ∧
    NondegenerateCentralConfiguration (masses (q 0) (pairChartMass (q 1) (q 2) (q 3))) (pairChartConfiguration q y)
DominantFiveBody.tripleChart_regular_root_physical (q : TripleChartParameters) (y : TripleChartVariables)
  (heps : 0 < q 0) (ht : 0 < q 1) (ha : ∑ i, tripleJointAlpha q i = 1)
  (hm : PositiveRatio (tripleChartMass (q 1) (tripleJointAlpha q)))
  (hreg : TripleChartRegular (q 0) (q 1) (tripleJointAlpha q) y)
  (hr : ∀ (i : Satellite), 0 < tripleChartRadii (q 1) (tripleJointAlpha q) y i)
  (hroot : tripleChartParameterRows q y = 0)
  (hJ : (tripleChartJacobian (q 0) (q 1) (tripleJointAlpha q) y).IsInvertible) :
  NormalizedCentralConfiguration (masses (q 0) (tripleChartMass (q 1) (tripleJointAlpha q)))
      (tripleChartConfiguration q y) ∧
    NondegenerateCentralConfiguration (masses (q 0) (tripleChartMass (q 1) (tripleJointAlpha q)))
      (tripleChartConfiguration q y)
DominantFiveBody.nestedContinuationRoot_fixed_mass_endpoint (t eta alpha : ℝ) (y : NestedChartVariables) (ht : 0 < t)
  (he : 0 < eta) (hm : PositiveRatio (nestedChartMass t eta alpha))
  (hdomain : NestedContinuationDomain (![0, t, eta, alpha], y)) (hroot : nestedChartExtendedRows 0 t eta alpha y = 0) :
  (∀ (i : Satellite), nestedChartRadii t eta alpha y i = 1) ∧
    y 2 = 0 ∧
      y 3 = 0 ∧
        RelativeCollisionFree (nestedChartPoints t eta alpha y) ∧
          SeparatedSemicircle (nestedChartAngles t eta alpha y) ∧
            ∀ (i : Satellite), coorbitalResidual (nestedChartMass t eta alpha) (nestedChartAngles t eta alpha y) i = 0
DominantFiveBody.reducedResidual_fixed_mass_zero_endpoint (μ : MassRatio) (y : SliceCoordinates) (hμ₀ : μ 0 ≠ 0)
  (hreg : SliceRegular (0, μ) y) (hsep : SeparatedSemicircle (sliceAngles y)) (hroot : reducedResidual (0, μ) y = 0) :
  (∀ (i : Satellite), sliceRadii y i = 1) ∧
    RelativeCollisionFree (sliceSatellites y) ∧ ∀ (i : Satellite), coorbitalResidual μ (sliceAngles y) i = 0
